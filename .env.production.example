# ─────────────────────────────────────────────────────────────────
# TAJ Technologie — PRODUCTION
# Copiez en .env sur le serveur :  cp .env.production.example .env
# puis remplissez TOUTES les valeurs. Ne committez JAMAIS le .env réel.
# ─────────────────────────────────────────────────────────────────

# ── Domaine & TLS ─────────────────────────────────────────────────
DOMAIN=votre-domaine.com                 # sans https:// (ex. erp.taj-tech.com)
ACME_EMAIL=admin@votre-domaine.com       # email pour Let's Encrypt

# ── Base de données PostgreSQL ────────────────────────────────────
DB_USERNAME=taj_user
DB_PASSWORD=CHANGEZ_MOI_mdp_db_fort
DB_NAME=taj_erp
# 'true' UNIQUEMENT au tout premier démarrage (crée le schéma sur une base vide),
# puis repassez à 'false' et relancez. Voir DEPLOYMENT.md.
DB_SYNCHRONIZE=false

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEZ_MOI_mdp_redis_fort

# ── JWT (générer :  openssl rand -hex 64) ─────────────────────────
JWT_SECRET=CHANGEZ_MOI_64_caracteres_minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=CHANGEZ_MOI_different_du_precedent
JWT_REFRESH_EXPIRY=7d

# ── Compte administrateur initial (créé au 1er démarrage) ─────────
SEED_ADMIN_EMAIL=admin@votre-domaine.com
SEED_ADMIN_PASSWORD=CHANGEZ_MOI_mdp_admin_fort
